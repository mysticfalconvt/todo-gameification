DATABASE_URL=postgres://postgres:postgres@localhost:5432/todo_gameification
BETTER_AUTH_SECRET=replace-with-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Generate with: pnpm dlx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: LLM-assigned XP scoring (OpenAI-compatible endpoint, e.g. LM Studio).
# Leave blank to skip auto-scoring; tasks then use the difficulty-based default.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Comma-separated list of emails that can access /admin. Matching is
# case-insensitive. Empty string (or missing var) means no one is admin.
ADMIN_EMAILS=

# Optional: Umami analytics. Both must be set to inject the tracking
# script into the document head. Leave either blank (or omit) to opt out.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# Optional: Bugsink (Sentry-compatible) error tracking. The DSN is a public
# identifier, not a secret — it's baked into the browser bundle at build time
# and read at runtime by the server. One value drives both the client and
# server SDKs. Leave blank to disable error tracking entirely.
# NOTE: because the client SDK reads this at BUILD time, it must be present in
# the build environment (e.g. set in Coolify) — not only at runtime.
VITE_SENTRY_DSN=
# Optional release identifier shown in Bugsink, e.g. todo-xp@1.2.3.
# VITE_SENTRY_RELEASE=

# Source-map upload to Bugsink (de-minifies browser stack traces). BUILD-TIME
# only — set these in the Coolify build environment, not at runtime. When both
# the token and project are present, the build emits hidden source maps,
# uploads them (with injected debug IDs), then deletes them from the output.
# Leave unset to skip entirely; traces then stay minified.
#   SENTRY_AUTH_TOKEN — create in the Bugsink UI (auth tokens). Secret.
#   SENTRY_PROJECT    — the Bugsink project slug for this app.
#   SENTRY_ORG        — optional; Bugsink ignores it (defaults to "bugsink").
#   SENTRY_URL        — optional; defaults to https://bugsink.rboskind.com/
# SENTRY_AUTH_TOKEN=
# SENTRY_PROJECT=
