{
  "name": "todo-gameification",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "prepare": "node scripts/install-hooks.mjs",
    "check": "./scripts/check.sh",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "fallow": "fallow",
    "fallow:audit": "fallow audit --base origin/main",
    "fallow:fix": "fallow fix --dry-run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31",
    "@sentry/node": "^11.11.0",
    "@sentry/react": "^11.11.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/query-sync-storage-persister": "^5.107.1",
    "@tanstack/react-devtools": "^0.10.14",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-persist-client": "^5.107.1",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.61",
    "better-auth": "^1.7.18",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.45.4",
    "idb-keyval": "^6.3.0",
    "nodemailer": "^10.3.1",
    "pg-boss": "^12.38.1",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "stripe": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@sentry/vite-plugin": "^11.11.0",
    "@tanstack/devtools-vite": "^0.8.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.11",
    "fallow": "^3.41.0",
    "jsdom": "^28.1.0",
    "nitro": "3.0.260415-beta",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
